Screen { background: $k-surface; color: $k-ink; text-style: none; }
#masthead { height: 4; border-bottom: solid $k-edge; padding: 1 2 0 2; align-vertical: middle; }
#brand { width: 24; }
#search-hint { width: 1fr; height: 1; color: $k-quiet; text-align: right; }
#body { height: 1fr; }
#navigation { width: 16; border-right: solid $k-edge; padding: 1 1 0 1; }
#nav-heading { height: 2; color: $k-quiet; }
#nav { height: 1fr; border: none; background: $k-surface; padding: 0; }
#browser { width: 1fr; padding: 1 2 0 2; }
#breadcrumb { height: 1; margin-bottom: 1; color: $k-quiet; }
#collection-header { height: 2; }
#heading { width: 1fr; height: 1; text-style: bold; color: $k-ink; text-wrap: nowrap; text-overflow: ellipsis; }
#collection-detail { width: auto; max-width: 45%; height: 1; color: $k-quiet; text-align: right; }
#tracks { height: 1fr; background: $k-surface; color: $k-ink; scrollbar-size-vertical: 1; scrollbar-color: $k-edge; scrollbar-background: $k-surface; }
#tracks:focus { background-tint: transparent; }
DataTable > .datatable--header { background: $k-surface; color: $k-quiet; text-style: none; }
#tracks:focus > .datatable--header { background-tint: transparent; }
DataTable > .datatable--cursor, DataTable:focus > .datatable--cursor { background: $k-selected; color: $k-ink; }
#nav > .option-list--option-highlighted { background: $k-surface; color: $k-accent; text-style: bold; }
#nav:focus > .option-list--option-highlighted { background: $k-selected; color: $k-ink; }
#tracks > .datatable--even-row, #tracks > .datatable--odd-row { background: $k-surface; }
#context { width: 32%; min-width: 30; max-width: 56; padding: 1 2; border-left: solid $k-edge; color: $k-quiet; }
#cover { width: 30; height: 15; margin-bottom: 1; }
#cover-placeholder { height: 3; color: $k-quiet; }
#record-details { height: auto; margin-bottom: 1; }
#record-note { height: auto; border-top: solid $k-edge; padding-top: 1; }
#fact-card { height: auto; border: round $k-edge; padding: 0 1; margin-top: 1; }
#fact-heading { height: 2; }
#fact-label { width: 1fr; color: $k-quiet; }
#fact-spark { width: auto; color: $k-accent; }
#fact-text { height: auto; color: $k-ink; }
#fact-source { height: auto; border-top: solid $k-edge; margin-top: 1; padding-top: 1; color: $k-quiet; }
#empty { height: auto; max-height: 4; color: $k-quiet; }
#status { height: 1; padding: 0 2; color: $k-quiet; }
#playback { height: 8; padding: 1 2 0 2; border-top: solid $k-edge; background: $k-surface; }
#now-playing { height: 2; }
#play-state { width: 3; height: 1; color: $k-accent; }
#playing-label { width: 1fr; height: 2; text-wrap: nowrap; text-overflow: ellipsis; }
#playing-time { width: 18; height: 1; text-align: right; color: $k-quiet; }
#animation { width: 100%; height: 3; text-wrap: nowrap; }
#progress { height: 1; }
#footer { height: 2; padding: 0 2; color: $k-quiet; }
#volume { width: 12; height: 1; text-align: right; }
#shortcuts { width: 1fr; height: 1; color: $k-quiet; text-wrap: nowrap; }
Input { background: #1c1920; border: tall $k-selected; color: $k-ink; }
Input:focus { border: tall $k-accent; }
FolderDialog { align: center middle; background: $k-surface 80%; }
#folder-dialog { width: 68; max-width: 95%; height: auto; padding: 1 2; border: round $k-accent; background: #19161c; }
#folder-dialog Label { text-style: bold; margin-bottom: 1; }
#folder-error, #facts-error { height: 2; color: #e2a895; }
NameDialog, PlaylistPicker, ConfirmDialog, FactsDialog { align: center middle; background: $k-surface 80%; }
.dialog { width: 68; max-width: 95%; height: auto; max-height: 90%; padding: 1 2; border: round $k-accent; background: #19161c; }
.dialog Label { text-style: bold; margin-bottom: 1; }
.dialog-hint { height: auto; margin-top: 1; color: $k-quiet; }
#playlist-choices { height: auto; max-height: 12; border: none; background: #19161c; }
.dialog-buttons { height: 3; margin-top: 1; }
.dialog-buttons Button { margin-right: 1; min-width: 10; }
Button { background: $k-selected; color: $k-ink; border: tall $k-edge; }
Button:focus { border: tall $k-accent; text-style: bold; }
#personalization { height: 1fr; width: 74; max-width: 95%; margin: 0 2; }
#appearance-heading { height: 3; padding-top: 1; text-style: bold; }
#appearance-fields { height: 1fr; }
#appearance-preview { height: 1; }
#appearance-explanation, #appearance-context { height: auto; margin-bottom: 1; color: $k-quiet; }
#appearance-feedback { height: auto; min-height: 1; margin-top: 1; color: $k-accent; }
.preference-row { height: 3; }
.preference-row Label { width: 18; padding-top: 1; color: $k-quiet; }
.preference-row Select { width: 1fr; }
Select > SelectCurrent { background: #1c1920; border: tall $k-edge; }
Select:focus > SelectCurrent { border: tall $k-accent; }
#appearance-buttons { height: 3; }
#appearance-buttons Button { margin-right: 1; min-width: 12; }
Screen.compact #masthead { height: 2; padding: 0 2; }
Screen.compact #brand { height: 1; width: 20; }
Screen.compact #navigation, Screen.compact #browser { padding-top: 0; }
Screen.compact #breadcrumb { margin-bottom: 0; }
Screen.compact #collection-header, Screen.compact #footer { height: 1; }
Screen.compact #playback { height: 7; padding-top: 0; }
Screen.compact #appearance-heading { height: 2; padding-top: 0; }
